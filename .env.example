# Copie este archivo a .env.local y complete los valores.
# En Vercel: Project Settings → Environment Variables.

# Cadena de conexión PostgreSQL. En Supabase: Connect → "Transaction pooler".
DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres

# Clave maestra de cifrado (32 bytes en base64). Genérela con:
#   openssl rand -base64 32
# Si se pierde, los datos de contacto ya guardados no pueden recuperarse.
DATA_ENCRYPTION_KEY=

# Envío de códigos por correo (https://resend.com). Sin estas variables, en
# desarrollo el código se imprime en la consola del servidor; en producción
# el envío falla.
RESEND_API_KEY=
EMAIL_FROM="GenCerteza <no-responder@su-dominio.com>"

# Token para que el laboratorio actualice el estatus de una muestra
# (PATCH /api/admin/solicitudes/GC-00000). Genérelo con: openssl rand -hex 32
ADMIN_API_TOKEN=
